[mysqld]
user=root
max_allowed_packet=100M
secure-file-priv=NULL
# Nextcloud reaches MySQL over loopback TCP rather than the unix socket, so
# networking stays on but is bound to loopback. The port is NOT set here: it
# is passed on the command line from $NEXTCLOUD_DB_PORT (src/mysql/utilities/
# mysql-utilities), which is the single source of truth for it.
bind-address=127.0.0.1
# Never reverse-resolve client IPs. A loopback TCP client is then always
# '<user>'@'127.0.0.1', which keeps the grants deterministic in the sandbox.
skip-name-resolve
skip-log-bin
transaction_isolation=READ-COMMITTED
log_error=../logs/mysql_errors.log
performance_schema=OFF
mysql_native_password=ON
